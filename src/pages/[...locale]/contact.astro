---
// src/pages/[...locale]/contact.astro - contact : un formulaire de demonstration complet, l'adresse directe, et ce qui se passe ensuite.
//
// Le formulaire est ECRIT mais NON MONTE : il n'a pas d'attribut action, il
// n'envoie rien, et c'est un choix. Le theme est 100% statique et sans adapter ;
// choisir un prestataire d'envoi a la place de l'utilisateur l'obligerait a le
// desinstaller avant d'installer le sien. Tout le reste est pret : le balisage,
// les libelles traduits, le cablage d'accessibilite (label lie au champ, aide
// annoncee par aria-describedby, champs requis marques). Pour le brancher :
// poser action et method vers le point d'arrivee de votre choix (Formspree,
// Netlify Forms, Web3Forms, ou une route d'API si vous ajoutez un adapter).
// t.contact.success et t.contact.error attendent ce moment-la : ce sont les deux
// messages a afficher au retour, deja traduits.
import Footer from "@components/Sections/Global/Footer.astro";
import Navbar from "@components/Sections/Global/Navbar.astro";
import PageHero from "@components/Sections/Global/PageHero.astro";
import { Icon } from "@components/svg/icons";
import { Button } from "@components/ui/button";
import { Input } from "@components/ui/input";
import { Label } from "@components/ui/label";
import { Textarea } from "@components/ui/textarea";
import siteData from "@config/siteData.json";
import { getLocale, localePaths, localizePath, useTranslations } from "@i18n";
import { breadcrumbList } from "@js/schema";
import BaseLayout from "@layouts/BaseLayout.astro";

export const getStaticPaths = localePaths;

const locale = getLocale(Astro);
const t = useTranslations(locale);

const title = t.contact.metaTitle;
const description = t.contact.metaDescription;

const base = Astro.site ?? Astro.url;
const crumbs = breadcrumbList([
  { name: t.common.home, url: new URL(localizePath("/", locale), base).href },
  { name: t.contact.metaTitle, url: new URL(localizePath("/contact/", locale), base).href },
]);
---

<BaseLayout {title} {description}>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(crumbs)} />
  </Fragment>

  <Navbar />

  <main id="content">
    <PageHero
      eyebrow={t.contact.eyebrow}
      title={t.contact.title}
      accentWord={t.contact.accent}
      lede={t.contact.lede}
      crumbs={[{ label: t.contact.metaTitle }]}
    />

    <div class="container-page grid gap-10 py-14 md:py-20 lg:grid-cols-12 lg:gap-14">
      <section class="lg:col-span-7" aria-labelledby="form-title">
        <div class="border-border bg-card rounded-panel border p-7 sm:p-9">
          <h2 id="form-title" class="font-display text-foreground text-2xl font-semibold tracking-tight">
            {t.contact.formTitle}
          </h2>

          <form class="mt-7 flex flex-col gap-5" name="contact" aria-describedby="contact-note" action="https://api.bettercms.ai/api/v1/forms/public/9ebba909-7dd6-4e30-8412-00bb79d38479/submissions" method="post" data-bcms-form="9ebba909-7dd6-4e30-8412-00bb79d38479" data-bcms-form-success="Thank you for your submission!">
            <div class="grid gap-5 sm:grid-cols-2">
              <p class="flex flex-col gap-2" data-bcms-form-field="name">
                <Label for="contact-name" required>{t.contact.nameLabel}</Label>
                <Input
                  id="contact-name"
                  name="name"
                  type="text"
                  autocomplete="name"
                  placeholder={t.contact.namePlaceholder}
                  required
                />
              </p>
              <p class="flex flex-col gap-2" data-bcms-form-field="email">
                <Label for="contact-email" required>{t.contact.emailLabel}</Label>
                <Input
                  id="contact-email"
                  name="email"
                  type="email"
                  autocomplete="email"
                  spellcheck="false"
                  placeholder={t.contact.emailPlaceholder}
                  required
                />
              </p>
            </div>

            <p class="flex flex-col gap-2" data-bcms-form-field="subject">
              <Label for="contact-subject">{t.contact.subjectLabel}</Label>
              <Input
                id="contact-subject"
                name="subject"
                type="text"
                placeholder={t.contact.subjectPlaceholder}
              />
            </p>

            <p class="flex flex-col gap-2" data-bcms-form-field="message">
              <Label for="contact-message" required>{t.contact.messageLabel}</Label>
              <Textarea
                id="contact-message"
                name="message"
                rows="6"
                placeholder={t.contact.messagePlaceholder}
                required
              />
            </p>

            <p id="contact-note" class="text-muted-foreground text-sm leading-relaxed">
              {t.contact.formNote}
            </p>

            <div>
              <Button type="submit" variant="primary" size="lg">
                {t.contact.submit}
                <Icon name="send" size={17} />
              </Button>
            </div>
          <p class="bcms-form-msg" hidden></p>
          </form>
          <script is:inline>
function bcmsPhone(cc,raw,trunk){var d=String(raw||'').trim();if(!d)return '';if(d.charAt(0)==='+'){var i=d.replace(/D/g,'');return i?'+'+i:'';}if(!cc)return d;var n=d.replace(/D/g,'');if(trunk&&n.charAt(0)==='0')n=n.slice(1);return n?'+'+cc+n:'';}
document.querySelectorAll('form[data-bcms-form]').forEach(function(f){
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var msg=f.querySelector('.bcms-form-msg');
    var data={};
    // A checkboxes group posts one entry per checked box under the SAME name; the old
    // one-at-a-time assignment kept only the last, so "pick many" delivered one answer.
    // One checked box still arrives as a scalar — FormData cannot tell a group from a
    // lone field — which is exactly why lib/forms/validate.ts's chosenValues() accepts
    // both an array and a comma string.
    new FormData(f).forEach(function(v,k){
      if(k==='cf-turnstile-response')return;
      if(Object.prototype.hasOwnProperty.call(data,k))data[k]=(Array.isArray(data[k])?data[k]:[data[k]]).concat(v);
      else data[k]=v;
    });
    // Country-picker phone fields post ONE key. The __country select is scaffolding: it is
    // composed into the field's own value here, AFTER collection, so a showIf that points at a
    // phone key still compares the raw digits. Then it is removed from the body.
    f.querySelectorAll('select[name$="__country"]').forEach(function(sel){
      var k=sel.name.slice(0,-9);
      var o=sel.options[sel.selectedIndex];
      data[k]=bcmsPhone(o?(o.getAttribute('data-cc')||''):'',data[k],o?o.getAttribute('data-trunk')==='1':false);
      delete data[k+'__country'];
    });
    var body={data:data};
    var tok=f.querySelector('[name="cf-turnstile-response"]');
    if(tok&&tok.value)body['cf-turnstile-response']=tok.value;
    fetch(f.action,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)})
      .then(function(r){return r.ok;})
      .then(function(ok){if(msg){msg.hidden=false;msg.textContent=ok?(f.getAttribute('data-bcms-form-success')||'Thanks! Your submission was received.'):'Sorry, something went wrong.';}if(ok)f.reset();})
      .catch(function(){if(msg){msg.hidden=false;msg.textContent='Sorry, something went wrong.';}});
  });
});
</script>
        </div>
      </section>

      <div class="flex flex-col gap-6 lg:col-span-5">
        <section
          class="border-border bg-surface rounded-card flex flex-col gap-3 border p-7"
          aria-labelledby="direct-title"
        >
          <span class="text-primary" aria-hidden="true"><Icon name="mail" size={22} /></span>
          <h2 id="direct-title" class="font-display text-foreground text-xl font-semibold tracking-tight">
            {t.contact.directTitle}
          </h2>
          <p class="text-muted-foreground text-[0.95rem] leading-relaxed">{t.contact.directLede}</p>
          <Button
            href={`mailto:${siteData.author.email}`}
            variant="outline"
            size="md"
            class="mt-2 self-start"
          >
            {t.contact.directCta}
          </Button>
        </section>

        <section
          class="border-border rounded-card flex flex-col gap-4 border p-7"
          aria-labelledby="next-title"
        >
          <h2 id="next-title" class="font-display text-foreground text-xl font-semibold tracking-tight">
            {t.contact.nextTitle}
          </h2>
          <ol class="flex flex-col gap-4">
            {
              t.contact.nextSteps.map((step, index) => (
                <li class="flex items-start gap-3">
                  <span
                    class="bg-primary/12 text-primary font-display rounded-pill mt-0.5 grid size-6 shrink-0 place-items-center text-xs font-semibold"
                    aria-hidden="true"
                  >
                    {index + 1}
                  </span>
                  <span class="text-muted-foreground text-[0.95rem] leading-relaxed">{step}</span>
                </li>
              ))
            }
          </ol>
        </section>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
